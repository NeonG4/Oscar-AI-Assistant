# Copy to .env.local for `npm start` / `vercel dev`, and add the same values in
# Vercel -> Project -> Settings -> Environment Variables for production.
# Redeploy after changing anything here in Vercel — env vars are read at deploy time.

# ============================================================== the agent ====

# Required: your OpenAI key. https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxx

# Optional: model to use. Cheap + fast is the right default for a notification agent.
OPENAI_MODEL=gpt-4o-mini

# Optional: how many words the agent is allowed for the notification body.
OSCAR_MAX_WORDS=60

# Optional: extra personality / standing instructions for the agent.
# e.g. "Answer in metric. I live in Seattle. Skip beginner explanations."
OSCAR_PERSONA=

# ====================================================== the iOS Shortcut ====

# Required: the Shortcut's credential, sent as the x-oscar-key header.
# Shortcuts can't read your email, so it uses a long secret instead of the
# password + code login. Make it long and random:  openssl rand -hex 24
OSCAR_SHARED_SECRET=change-me-to-a-long-random-string

# ======================================================= the website login ==

# Required: the password you type on the website. Anything you like.
OSCAR_PASSKEY=choose-a-strong-passphrase

# Optional alternative to the above, if you'd rather not store the plaintext.
# Set ONE of these, not both. This one wins if present.
#   node -e "console.log(require('crypto').createHash('sha256').update('YOUR PASSWORD').digest('hex'))"
# OSCAR_PASSKEY_HASH=

# Required: where the 6-character sign-in code gets emailed. Only this address
# is ever used — it is not taken from anything the browser sends.
OSCAR_OWNER_EMAIL=davidstall312@gmail.com

# Recommended: signs login sessions. Changing it signs every browser out
# immediately, without affecting the Shortcut. Falls back to OSCAR_SHARED_SECRET
# if unset.  openssl rand -hex 32
OSCAR_SESSION_SECRET=

# ---- email delivery: set ONE of these three ----
# Whichever key is present is the provider that gets used. With none set, the
# code is printed to your Vercel function logs so you can still sign in.

# Resend — easiest. Free tier, and onboarding@resend.dev delivers to your own
# account email without owning a domain.  https://resend.com
RESEND_API_KEY=

# Postmark — needs a verified sender signature.  https://postmarkapp.com
# POSTMARK_TOKEN=

# SendGrid — needs a verified single sender.  https://sendgrid.com
# SENDGRID_API_KEY=

# Optional: the From address on the code email. Must be an address the provider
# above has authorised. Defaults to Resend's shared onboarding sender.
# OSCAR_MAIL_FROM=Oscar <oscar@yourdomain.com>

# Optional: extra browser origins allowed to call the API with a session cookie.
# Your own deployment is always allowed; you almost certainly don't need this.
# OSCAR_ALLOWED_ORIGINS=https://another-site-you-own.com

# ===================================================== database (optional) ==
# Logs every question and answer, and powers the History tab. Oscar works
# without these — see SUPABASE.md for the ten-minute setup.

# Supabase -> Project Settings -> API -> Project URL
SUPABASE_URL=

# Supabase -> Project Settings -> API -> Project API keys -> service_role
#
# NOT the anon key. The service_role key bypasses Row Level Security entirely,
# which is why it may only ever live server-side. Never put it in public/,
# never send it to a browser, never commit it.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: only if you renamed the table in db/schema.sql
# SUPABASE_TABLE=conversations
