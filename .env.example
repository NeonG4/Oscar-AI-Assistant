# Copy to .env.local for `vercel dev`, and add the same values in
# Vercel -> Project -> Settings -> Environment Variables for production.

# Required: your OpenAI key.
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxx

# Optional: model to use. Cheap + fast is the right default for a notification agent.
OPENAI_MODEL=gpt-4o-mini

# Required in practice: a shared secret so random people can't burn your API credits.
# Make one up (e.g. `openssl rand -hex 24`). The Shortcut sends it as the x-oscar-key header.
OSCAR_SHARED_SECRET=change-me-to-a-long-random-string

# Optional: how many words the agent is allowed for the notification body.
OSCAR_MAX_WORDS=60

# Optional: extra personality / standing instructions for the agent.
OSCAR_PERSONA=
