# Copy to .env.local for `npm start` / `vercel dev`, and add the same values in
# Vercel -> Project -> Settings -> Environment Variables for production.
# Redeploy after changing anything here in Vercel — env vars are read at deploy time.

# ============================================================== the agent ====

# Required: your OpenAI key. https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxx

# Optional: model to use. Cheap + fast is the right default for a notification agent.
OPENAI_MODEL=gpt-4o-mini

# Optional: how many words the agent is allowed for the notification body.
OSCAR_MAX_WORDS=60

# Optional: extra personality / standing instructions for the agent.
# e.g. "Answer in metric. I live in Seattle. Skip beginner explanations."
OSCAR_PERSONA=

# ====================================================== the iOS Shortcut ====

# Required: the Shortcut's credential, sent as the x-oscar-key header.
# Shortcuts can't read your email, so it uses a long secret instead of the
# password + code login. Make it long and random:  openssl rand -hex 24
OSCAR_SHARED_SECRET=change-me-to-a-long-random-string

# ======================================================= the website login ==

# Required: the password you type on the website. Anything you like.
OSCAR_PASSKEY=choose-a-strong-passphrase

# Optional alternative to the above, if you'd rather not store the plaintext.
# Set ONE of these, not both. This one wins if present.
#   node -e "console.log(require('crypto').createHash('sha256').update('YOUR PASSWORD').digest('hex'))"
# OSCAR_PASSKEY_HASH=

# Required: where the 6-character sign-in code gets emailed. Only this address
# is ever used — it is not taken from anything the browser sends.
OSCAR_OWNER_EMAIL=davidstall312@gmail.com

# Recommended: signs login sessions. Changing it signs every browser out
# immediately, without affecting the Shortcut. Falls back to OSCAR_SHARED_SECRET
# if unset.  openssl rand -hex 32
OSCAR_SESSION_SECRET=

# ---- email delivery: set ONE of these three ----
# Whichever key is present is the provider that gets used. With none set, the
# code is printed to your Vercel function logs so you can still sign in.

# Resend — easiest. Free tier, and onboarding@resend.dev delivers to your own
# account email without owning a domain.  https://resend.com
RESEND_API_KEY=

# Postmark — needs a verified sender signature.  https://postmarkapp.com
# POSTMARK_TOKEN=

# SendGrid — needs a verified single sender.  https://sendgrid.com
# SENDGRID_API_KEY=

# Optional: the From address on the code email. Must be an address the provider
# above has authorised. Defaults to Resend's shared onboarding sender.
# OSCAR_MAIL_FROM=Oscar <oscar@yourdomain.com>

# Optional: extra browser origins allowed to call the API with a session cookie.
# Your own deployment is always allowed; you almost certainly don't need this.
# OSCAR_ALLOWED_ORIGINS=https://another-site-you-own.com

# ===================================================== database (optional) ==
# Logs every question and answer, and powers the History tab. Oscar works
# without these — see SUPABASE.md for the ten-minute setup.

# Supabase -> Project Settings -> API -> Project URL
SUPABASE_URL=

# Supabase -> Project Settings -> API -> Project API keys -> service_role
#
# NOT the anon key. The service_role key bypasses Row Level Security entirely,
# which is why it may only ever live server-side. Never put it in public/,
# never send it to a browser, never commit it.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: only if you renamed the table in db/schema.sql
# SUPABASE_TABLE=conversations

# ======================================================== tools (optional) ==
# Weather and location. Both use free, keyless APIs — nothing to sign up for.
# See TOOLS.md.

# imperial = °F, mph, inches.  metric = °C, km/h, mm.
OSCAR_UNITS=imperial

# Last-resort location, used only when there's no GPS from the Shortcut and
# your IP doesn't resolve. e.g. "Seattle, WA"
OSCAR_HOME_LOCATION=

# Set to 1 to turn all tools off (useful when isolating a problem).
# OSCAR_DISABLE_TOOLS=

# Set to 1 to skip turning coordinates into a city name. Slightly faster;
# answers say "your location" instead of naming somewhere.
# OSCAR_DISABLE_REVERSE_GEOCODE=

# ======================================================= google (optional) ==
# Gmail, Calendar and Tasks. Full setup walkthrough in GOOGLE.md.
# Run `npm run google-auth` on your own machine to obtain the refresh token.

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Master switch for anything that CHANGES something — creating events, adding
# tasks, drafting or sending mail. Without this set to 1, Oscar is read-only no
# matter what any individual request claims.
OSCAR_ALLOW_WRITES=

# A SECOND secret, separate from OSCAR_SHARED_SECRET, sent as the x-oscar-write
# header. This is what lets you have a read-only "Ask Oscar" shortcut and a
# separate write-capable one — so the everyday key can never send mail as you.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OSCAR_WRITE_SECRET=

# Strongly recommended: comma-separated addresses send_email is allowed to write
# to. Unset means anyone. Set it to your own address while you get comfortable.
GOOGLE_SEND_ALLOWLIST=

# ================================================ destructive actions ======
# Oscar can delete calendar events, delete tasks, and move mail to the bin.
# There is no permanent-delete tool anywhere: mail goes to the bin (recoverable
# for 30 days), and nothing can be destroyed irrecoverably.
#
# By default, DICTATED requests ask for confirmation and TYPED web requests do
# not. Speech gets misheard; typing on a screen doesn't. See SHORTCUT.md.

# Set to 1 to require confirmation on every route, including typed web input.
# OSCAR_CONFIRM_ALWAYS=

# Set to 1 to also confirm before SENDING email (it is irreversible too).
# Off by default because draft_email already covers the unconfirmed case.
# OSCAR_CONFIRM_SEND=

# ==================================================== how hard Oscar works ==
# The agent chains tools until it has what it needs. These bound that, and the
# deadline is the one that matters on the synchronous path.

# Wall clock for one synchronous request, in ms. An iOS Shortcut will not wait
# much longer than this.
OSCAR_TOOL_DEADLINE_MS=25000

# Backstop against a stuck model, not a design constraint.
OSCAR_MAX_TOOL_ROUNDS=12

# Total tool executions in one run, so cost stays bounded.
OSCAR_MAX_TOOL_CALLS=40

# ================================================ routing & background work ==
# Simple questions answer inline in a couple of seconds. Real work becomes a
# background job that is not bounded by how long the caller will wait.

# Which model answers a quick lookup vs. does real work.
OSCAR_FAST_MODEL=gpt-4o-mini
OSCAR_DEEP_MODEL=gpt-4o

# The classifier that decides. Cheap and capped at one word; most questions are
# settled by keyword before it is even called.
# OSCAR_ROUTER_MODEL=gpt-4o-mini

# Set to 1 to send everything down the fast path.
# OSCAR_DISABLE_ROUTING=

# How long ONE /api/step invocation works before checkpointing and handing off
# to a fresh one. Keep it comfortably under your Vercel maxDuration (60s) so
# there is room to save state — losing the checkpoint is the worst failure here.
OSCAR_STEP_BUDGET_MS=40000

# Normally derived from VERCEL_URL. Set it only if jobs are not continuing on
# their own — without it, a job advances only while the web app is polling.
# OSCAR_BASE_URL=https://oscar-ai-assistant.vercel.app/


# ============================================================ your computer ==
# Lets Oscar run commands on your own machine: "run the tests on my laptop".
# Read RUNNER.md before enabling this — it is the most powerful thing Oscar can
# do, and the only part that can damage something you care about.
#
# Nothing listens on a port. Your laptop polls OUT to /api/runner, claims one
# command at a time, and posts the output back. The laptop applies its own
# allowlist and has the final say on what actually executes.

# A SEPARATE secret, not the Shortcut key and not the write key. Rotating this
# one value cuts a stolen laptop off without disturbing anything else.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Set it in Vercel AND in .env.local on the machine that runs the runner.
# Unset on the server, run_cmd is withheld from the model entirely.
# OSCAR_RUNNER_SECRET=

# ---- the next two are read by scripts/runner.js on your laptop, not by the
# ---- server. They belong in .env.local, not in Vercel.

# Which deployment the runner polls. Shared with the jobs setting above.
# OSCAR_BASE_URL=https://oscar-ai-assistant.vercel.app

# The directory tree commands are confined to. A cwd outside it is refused,
# not clamped. Defaults to wherever you started the runner.
# OSCAR_RUNNER_ROOT=

# How often the runner asks for work, in ms. It backs off when idle.
# OSCAR_RUNNER_INTERVAL_MS=3000


# ============================================================ notifications ==
# Real notifications on your phone from the website, with no Shortcut involved.
# Read PUSH.md — on iPhone this ONLY works once Oscar is added to the Home
# Screen, which is a property of iOS and not something the code can work around.
#
# Generate the pair once:
#   npm run vapid
# Both go in Vercel. The public one is handed to every browser that subscribes
# and is meant to be seen; the private one signs each send and must not leak.
# Notifications also need Supabase — there is nowhere else to keep the devices.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=

# A contact for whoever operates the sender, as mailto: or https:. Push services
# are supposed to be able to reach a human about a misbehaving sender.
# Defaults to OSCAR_OWNER_EMAIL, which is almost always what you want.
# VAPID_SUBJECT=


# ================================================================ missions ==
# "Write me a connect 4 program" -> Oscar plans it, works the plan one step at
# a time, then notifies you. See MISSIONS.md.
#
# Nothing to configure. A mission needs OSCAR_ALLOW_WRITES=1 (it saves a plan
# and acts on it) and Supabase (that is where the plan lives). Without write
# authority a mission request is quietly demoted to an ordinary deep job.
#
# It gets far more rope than a normal job — 300 rounds rather than 40 — because
# each step runs in its own fresh context rather than one growing conversation.
# Add the runner (RUNNER.md) if you want missions that write real files.


# =============================================================== questions ==
# Oscar stopping to ask YOU something, then sleeping until you answer. See
# QUESTIONS.md.
#
# Nothing to configure. It needs Supabase (the question has to outlive the run
# that asked it) and, realistically, notifications — a question you never hear
# about stalls a run indefinitely. Asking needs no write authority, since a
# question changes nothing; answering is session-only, because it resumes a run
# that can write files and spend credit.
